# Скопируй в .env и заполни. .env в git не попадает (см. .gitignore).

# Токен бота от @BotFather
BOT_TOKEN=

# Ключ Anthropic (console.anthropic.com)
ANTHROPIC_API_KEY=

# Твой telegram user_id - туда падают уведомления о лидах.
# Узнать: напиши боту /whoami
ADMIN_CHAT_ID=

# --- дальше все опционально, значения по умолчанию рабочие ---

CLAUDE_MODEL=claude-opus-5

# Цена повторной диагностики в звездах Telegram (~3$ по курсу ~0.016$/звезда)
PRICE_STARS=188

# Путь к базе. На хостинге положи на постоянный диск (volume).
DB_PATH=data/bot.db

# Ссылки
SITE_URL=https://tkachenko-ai.com
CHAT_URL=

# HTTP-порт для health-check (Render/Koyeb требуют открытый порт)
PORT=8080

# Публичный URL сервиса. Если задан - бот сам себя пингует, чтобы
# бесплатный хостинг не усыплял процесс. Пример: https://mybot.onrender.com
KEEPALIVE_URL=
KEEPALIVE_INTERVAL=600
